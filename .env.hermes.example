# QuantG Hermes Sidecar Configuration Template
# Copy this file to .env.hermes on your VPS and fill in the values.

# Telegram Bot Credentials (Get from @BotFather and @userinfobot on Telegram)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_personal_chat_id_here

# QuantG API Access (Using internal docker network container URL)
QUANTG_BACKEND_URL=http://backend:8000/api

# Operator credentials to retrieve JWT access tokens for API requests
QUANTG_OPERATOR_EMAIL=demo@quantdesk.io
QUANTG_OPERATOR_PASSWORD=demo1234
