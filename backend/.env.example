# QuantG Backend Environment Variables
# Copy this file to .env and fill in your values before starting the app.
# Never commit your actual .env file to version control.

# ─── Database ─────────────────────────────────────────────────────────────────
MONGO_URL=mongodb://localhost:27017
MONGO_URI=mongodb://localhost:27017
DB_NAME=quantg

# ─── Security (REQUIRED — change before any production use) ───────────────────
# Use a strong random value: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=CHANGE_ME_use_a_strong_random_secret

# Separate key for encrypting broker credentials at rest.
# Generate: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=CHANGE_ME_generate_a_fernet_key

# ─── Upstox Broker (required for live trading) ────────────────────────────────
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_REDIRECT_URI=https://yourdomain.com/api/broker/upstox/callback

# These are refreshed via OAuth — do not hardcode in production.
UPSTOX_ACCESS_TOKEN=
UPSTOX_REFRESH_TOKEN=

# Upstox request timeout in seconds (default: 15)
UPSTOX_TIMEOUT_SEC=15

# Maximum order placement retry attempts (default: 3)
UPSTOX_ORDER_MAX_ATTEMPTS=3

# Algo registration name shown in Upstox order tags
UPSTOX_ALGO_NAME=QuantGAlgo

# Set to true to use Upstox sandbox instead of live API
UPSTOX_SANDBOX=false

# ─── Trading Engine ───────────────────────────────────────────────────────────
# Master switch for the core engine
CORE_ENGINE_ENABLED=true

# Enable paper (simulated) trading mode
CORE_ENGINE_PAPER_ENABLED=true

# Enable LIVE trading — set to true only when you are ready.
# Defaults to false. Must be explicitly enabled.
CORE_ENGINE_LIVE_ENABLED=false

# Shadow mode: execute logic but never submit real orders (dry-run)
CORE_ENGINE_SHADOW_MODE=false

# Allow LEGACY execution writes (keep false unless migrating)
LEGACY_EXECUTION_WRITES_ENABLED=false

# ─── Strategy Runner ──────────────────────────────────────────────────────────
# How often the strategy tick loop runs (seconds)
STRATEGY_RUNNER_TICK_SECONDS=30

# Strategy execution timeout (seconds)
STRATEGY_TIMEOUT_SEC=10

# Maximum allowed strategy quarantine score before disabling
STRATEGY_QUARANTINE_THRESHOLD=3

# Maximum age (seconds) for live candle data before it is considered stale
STRATEGY_LIVE_CANDLE_MAX_AGE_SEC=120

# ─── Signal Manager ───────────────────────────────────────────────────────────
SIGNAL_MANAGER_TICK_SECONDS=15

# Minimum confidence score (0–100) required to act on a signal
SIGNAL_CONFIDENCE_MIN=45

# Spam protection: max identical signals in window
SIGNAL_SPAM_THRESHOLD=3
SIGNAL_SPAM_WINDOW_SECONDS=300

# ─── AI / Gemini ──────────────────────────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview
GEMINI_TIMEOUT_SEC=30

# ─── Option Ledger (SQLite state file) ────────────────────────────────────────
OPTION_LEDGER_PATH=/data/runtime_state.sqlite3
OPTION_LEDGER_POOL_SIZE=5

# Maximum age (seconds) before an option quote is considered stale
QUANTG_OPTION_STALE_SEC=90

# ─── Market Data ──────────────────────────────────────────────────────────────
# Allow simulated/synthetic prices when real data is unavailable (paper mode only)
QUANTG_ALLOW_SIMULATED_PRICES=false

# Upstox quote stale threshold (seconds)
UPSTOX_QUOTE_STALE_SECONDS=60

# Broker reconciliation interval (seconds)
BROKER_RECONCILE_INTERVAL_SEC=300

# ─── App / Public URL ─────────────────────────────────────────────────────────
APP_PUBLIC_URL=https://yourdomain.com
PUBLIC_APP_URL=https://yourdomain.com

# ─── Market Holidays (optional override) ──────────────────────────────────────
# Comma-separated list of dates in YYYY-MM-DD format (IST)
# MARKET_HOLIDAYS_IST=2025-01-26,2025-03-14,2025-04-14
