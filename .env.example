# =========================================================
# QuantG Backend — Environment Variable Reference
# Copy this file to backend/.env and fill in real values.
# NEVER commit backend/.env to version control.
# =========================================================

# --- MongoDB ---
MONGO_URL=mongodb://mongo:27017
MONGO_URI=mongodb://mongo:27017   # Alias used by option_state_ledger.py
DB_NAME=quantg

# --- Security (REQUIRED — rotate before first production deploy) ---
# JWT_SECRET must be a cryptographically random 64-char hex string.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace-with-a-cryptographically-random-64-char-hex-string

# Fernet key for encrypting stored broker credentials.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# MUST be different from JWT_SECRET.
CREDENTIAL_ENCRYPTION_KEY=replace-with-a-fernet-key

# --- CORS ---
CORS_ORIGINS=http://localhost:3000,https://yourdomain.com

# --- Upstox Broker (saved via UI, but can also be pre-seeded here) ---
UPSTOX_API_KEY=your_upstox_api_key
UPSTOX_API_SECRET=your_upstox_api_secret
UPSTOX_REDIRECT_URI=https://yourdomain.com/api/broker/upstox/callback
UPSTOX_ACCESS_TOKEN=

# --- Google AI (optional — AI features fall back to local rules if not set) ---
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SEC=20

# --- Strategy Runner ---
STRATEGY_RUNNER_TICK_SECONDS=15
SIGNAL_CONFIDENCE_MIN=45

# --- Test isolation (set to "true" only in CI/test environments) ---
# Setting this to "true" makes option_state_ledger use a separate DB named <DB_NAME>_test.
# NEVER set to "true" in production.
QUANTG_TEST_DB=false
